{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ng: serve",
            "type": "npm",
            "script": "start",
            "path": "",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": {
                "owner": "typescript",
                "source": "ts",
                "applyTo": "closedDocuments",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": "$tsc",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": {
                        "regexp": "(.*?)"
                    },
                    "endsPattern": {
                        "regexp": "bundle generation complete|Compiled successfully|Application bundle generation complete|Local:"
                    }
                }
            }
        }
    ]
}
